{
  "name": "poker-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "德扑训练大师 - 纯学习练习工具 (Texas Hold'em practice trainer, learning-only)",
  "scripts": {
    "dev": "vite",
